@startuml
title Diagrama de clases - Proyecto original
class Cliente {
  +String nombre
  +String email
  +boolean socio
  +Cliente(nombre, email, socio)
}
class Funcion {
  +String titulo
  +int sala
  +String hora
  +double precio
  +List<String> ocupados
  +ocupar(fila, numero)
  +setPrecio(precio)
}
class Reserva {
  +int id
  +Cliente cliente
  +Funcion funcion
  +List<String> asientos
  +double precio
  +boolean cancelada
  +setCancelada(cancelada)
}
class SistemaReservas {
  +Map<Integer, Object> db
  +int contador
  +hacer(nombre, email, socio, funcion, filas, numeros, imprimir, canal)
  +calcularPrecio(reserva, tipo)
  +descuentoDel15(precio)
  +descuentoDel25(precio)
  +cancelar(id)
  +buscar(id)
}
class Main {
  +main(args)
}
SistemaReservas "1" o-- "*" Reserva
Reserva "*" --> "1" Cliente
Reserva "*" --> "1" Funcion
Main ..> SistemaReservas
@enduml
